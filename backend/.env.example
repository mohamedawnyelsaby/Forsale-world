# backend/.env.example
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file to git.

# Postgres connection string (Supabase, Neon, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/forsale"

# Supabase (if used for auth/storage alongside Prisma)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Sela AI Agent (Claude) - server-side only, never expose to the frontend
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

PORT=5000
