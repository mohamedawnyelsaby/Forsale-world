# frontend/.env.example
# Copy to frontend/.env and adjust per environment.
# CRA only exposes vars prefixed with REACT_APP_ to the browser bundle.

# Points at the backend's agent endpoint directly, or at a Cloudflare Worker
# proxy in front of it if you deploy the frontend as a static/serverless app.
REACT_APP_AGENT_URL="http://localhost:5000/api/agent/chat"
